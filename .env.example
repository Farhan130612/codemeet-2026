# Server Environment Variables
NODE_ENV=production
PORT=3001
CLIENT_URL=http://localhost:5173

# Admin Access Credentials (Constant-time server comparison)
# Set your secure 8+ digit / alphanumeric event master password here:
ADMIN_ACCESS_CODE=20268899

# Session secret used to sign admin cookies (HMAC-SHA256)
SESSION_SECRET=codemeet-2026-super-secure-secret-key-32b

# Database configuration (defaults to SQLite in ./data with WAL mode)
DATABASE_PATH=./data/codemeet_typing.db

# Optional Sentry error monitoring DSN
# SENTRY_DSN=https://your-key@sentry.io/123456
